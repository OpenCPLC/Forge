{
  "version": "0.2.0",
  "tasks": [
    {
      "label": "make",
      "type": "shell",
      "command": "make",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ],
  "configurations": [
    {
      "name": "Debug",
      "cwd": "${workspaceRoot}",
      "executable": "${BUILD_PATH}/${TARGET}.elf",
      "symbolFiles": [{"file": "${BUILD_PATH}/${TARGET}.elf"}, {"file": "${BOOT_ELF}"}],
      "loadFiles": ["${BUILD_PATH}/${TARGET}-dist.hex"],
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "armToolchainPath": "${TOOLS_ARM_DIR}",
      "serverpath": "${TOOLS_OPENOCD_EXE}",
      "device": "${DEVICE}",
      "configFiles": [
        "interface/stlink.cfg",
        "target/${OPENOCD_TARGET}.cfg"
      ],
      "openOCDPreConfigLaunchCommands": ["adapter serial ${STLINK}"],
      "svdFile": "${CORE_PATH}/hal/svd/${SVD}",
      "preLaunchTask": "make"
    }
  ]
}