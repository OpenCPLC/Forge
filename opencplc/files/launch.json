{
  "version": "0.2.0",
  "tasks": [
    {
      "label": "make",
      "type": "shell",
      "command": "make",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ],
  "configurations": [
    {
      "name": "Debug",
      "cwd": "${workspaceRoot}",
      "executable": "${BUILD_DIR}/${TARGET}.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "device": "${DEVICE}",
      "configFiles": [
        "interface/stlink.cfg",
        "target/${OPENOCD_TARGET}.cfg"
      ],
      "openOCDPreConfigLaunchCommands": ["adapter serial ${STLINK}"],
      "svdFile": "${CORE_DIR}/hal/svd/${SVD}",
      "preLaunchTask": "make"
    }
  ]
}