{
  "configurations": [
    {
      "name": "${NAME}",
      "includePath": [
        "${workspaceFolder}/${CORE_DIR}/hal/arm/**",
        "${workspaceFolder}/${CORE_DIR}/hal/stm32/**",
        "${workspaceFolder}/${CORE_DIR}/hal/${HAL}/**",
        "${workspaceFolder}/${CORE_DIR}/lib/**",
        "${workspaceFolder}/${CORE_DIR}/dvr/**",
        "${workspaceFolder}/${CORE_DIR}/brd",
        "${workspaceFolder}/${CORE_DIR}/brd/${BOARD_LOWER}/**",
        "${workspaceFolder}/${CORE_DIR}/plc/com/**",
        "${workspaceFolder}/${CORE_DIR}/plc/per/**",
        "${workspaceFolder}/${PRO_DIR}/**"
      ],
      "defines": [
        "OpenCPLC",
        "${PLATFORM}",
        "${FAMILY}",
        "${DEFINE}"
      ],
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "gcc-arm",
      "compilerPath": "${env:ARMGCC}/arm-none-eabi-gcc.exe",
      "compilerArgs": [
        "-mcpu=${CPU}",
        "-mthumb"
      ]
    }
  ],
  "version": 4
}
