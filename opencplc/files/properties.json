{
  "configurations": [
    {
      "name": "${NAME}",
      "includePath": [
        "${CORE_PATH}/hal/arm/**",
        "${CORE_PATH}/hal/stm32/**",
        "${CORE_PATH}/hal/${HAL}/**",
        "${CORE_PATH}/lib/**",
        "${CORE_PATH}/drv/**",
        "${CORE_PATH}/brd",
        "${CORE_PATH}/brd/${BOARD_LOWER}/**",
        "${CORE_PATH}/plc/com/**",
        "${CORE_PATH}/plc/io/**",
        "${CORE_PATH}",
        "${PRO_PATH}/**"
      ],
      "defines": [
        "OpenCPLC",
        "${PLATFORM}",
        "${FAMILY}",
        "${DEFINE}"
      ],
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "gcc-arm",
      "compilerPath": "${TOOLS_ARM_GCC}",
      "compilerArgs": [
        "-mcpu=${CPU}",
        "-mthumb"
      ]
    }
  ],
  "version": 4
}
